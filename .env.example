# GuitarLab configuration — copy to `.env` and fill in what you need.
#
# Every integration is optional. The app opens and works with this file empty:
# each disabled integration only switches off its own feature and says what is
# missing in Settings. The one thing that is NOT optional is FFmpeg, which must
# be installed and on your PATH for audio import to work.
#
# Precedence: real environment variables > this file > built-in defaults.

# ─── Media folders ────────────────────────────────────────────────────────────
# Leave empty to use ./gptabs, ./songs and ./.stems next to the project.
# In an installed build these are picked in Settings instead.
GPTABS_DIR=
SONGS_DIR=
STEMS_DIR=

# Absolute path to the ffmpeg binary. Empty = use whatever is on PATH.
# ffprobe is derived from the same path.
FFMPEG_PATH=

# ─── Spotify (optional) ───────────────────────────────────────────────────────
# developer.spotify.com/dashboard — PKCE flow, so there is no client secret.
# Register the redirect URI below in your Spotify app settings.
# Used for metadata and for driving an already-running Spotify via Connect.
# Note: audio-features/audio-analysis were discontinued by Spotify and are not
# used; BPM and key come from the Guitar Pro file or from local analysis.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ─── YouTube (optional) ───────────────────────────────────────────────────────
# console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
# The free quota is 10000 units/day and each search costs 100, so roughly 100
# songs per day. The app spends one search per song and classifies locally.
YOUTUBE_API_KEY=
YOUTUBE_QUOTA_LIMIT=10000

# ─── AI providers (optional) ──────────────────────────────────────────────────
# Used for practice plans, technique breakdowns, tone patches and for turning
# pasted chord sheets into ChordPro.
#
# LLM_PROVIDER is tried first; LLM_FALLBACK_PROVIDER is a comma-separated list
# tried in order when it fails. Valid values: gemini | openai | groq | ollama
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openai,ollama

# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# platform.openai.com/api-keys
# OPENAI_BASE_URL lets you point at any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local models via Ollama — no API key, nothing leaves your machine.
# Install from ollama.com, then `ollama pull <model>`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# ─── MusicBrainz (optional, no key needed) ────────────────────────────────────
# Their guidelines ask for a User-Agent that identifies your build.
MUSICBRAINZ_USER_AGENT=GuitarLab/0.1 ( guitarlab )

# ─── Audio lab container (optional, needs Docker) ─────────────────────────────
# Only stem separation and automatic BPM/key/chord analysis need this.
# htdemucs_6s = 6 stems; htdemucs = 4 stems, better quality.
# DEMUCS_SEGMENT chunks the audio so it fits in an 8 GB GPU.
FORGE_LAB_URL=http://127.0.0.1:8756
DEMUCS_MODEL=htdemucs_6s
DEMUCS_SEGMENT=7

# ─── Escape hatch ─────────────────────────────────────────────────────────────
# Force the project root instead of letting the app walk up looking for it.
# GUITARLAB_ROOT=

# No key required, nothing to configure: LRCLIB (synced lyrics), archive.org
# (audio download), alphaTab, and every local model.
