{
  "name": "guitarlab",
  "version": "0.2.0",
  "description": "GuitarLab — estudo de guitarra: setlist, tablatura, stems, cifras e timbres",
  "main": "./out/main/index.js",
  "author": "Paulo Brandao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulobrandaodev/GuitarLab.git"
  },
  "bugs": {
    "url": "https://github.com/paulobrandaodev/GuitarLab/issues"
  },
  "homepage": "https://github.com/paulobrandaodev/GuitarLab#readme",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-vite build && electron-builder --dir",
    "shots": "node scripts/screenshots.mjs",
    "dist": "electron-vite build && electron-builder",
    "test:llm": "tsx --tsconfig tsconfig.node.json scripts/test-llm.ts",
    "test:media": "electron scripts/test-media.mjs",
    "test:tabscroll": "electron scripts/test-tabscroll.mjs",
    "test:stretch": "electron scripts/test-stretch.mjs",
    "test:player": "electron scripts/test-player.mjs",
    "test:newsong": "electron scripts/test-newsong.mjs",
    "test:ci": "npm run typecheck && npm run test:i18n && npm run test:settings && npm run test:labsetup && npm run test:manual && npm run test:chords && npm run test:tempo && npm run test:cifra && npm run test:sort && npm run test:tone && npm run test:markdown && npm run test:ytplayer && npm run build && npm run test:secrets && npm run test:stretch && npm run test:newsong",
    "test": "npm run typecheck && npm run test:i18n && npm run test:settings && npm run test:labsetup && npm run test:stems && npm run test:setlist && npm run test:manual && npm run test:sources && npm run test:chords && npm run test:tempo && npm run test:cifra && npm run test:sort && npm run test:tone && npm run test:markdown && npm run test:chordmap && npm run test:stream && npm run test:ytplayer && npm run test:tabscroll && npm run test:media && npm run build && npm run test:secrets && npm run test:stretch && npm run test:player && npm run test:newsong && npm run test:llm",
    "test:ytplayer": "tsx --tsconfig tsconfig.node.json scripts/test-ytplayer.ts",
    "test:i18n": "tsx --tsconfig tsconfig.node.json scripts/test-i18n.ts",
    "test:settings": "tsx --tsconfig tsconfig.node.json scripts/test-settings.ts",
    "test:secrets": "electron scripts/test-secrets.mjs",
    "test:stems": "tsx --tsconfig tsconfig.node.json scripts/test-stems.ts",
    "test:stream": "tsx --tsconfig tsconfig.node.json scripts/test-stream.ts",
    "test:setlist": "tsx --tsconfig tsconfig.node.json scripts/test-setlist.ts",
    "test:sources": "tsx --tsconfig tsconfig.node.json scripts/test-sources.ts",
    "test:chords": "tsx --tsconfig tsconfig.node.json scripts/test-chords.ts",
    "test:tempo": "tsx --tsconfig tsconfig.node.json scripts/test-tempo.ts",
    "test:cifra": "tsx --tsconfig tsconfig.node.json scripts/test-cifra.ts",
    "test:sort": "tsx --tsconfig tsconfig.node.json scripts/test-sort.ts",
    "test:tone": "tsx --tsconfig tsconfig.node.json scripts/test-tone.ts",
    "test:markdown": "tsx --tsconfig tsconfig.web.json scripts/test-markdown.tsx",
    "test:manual": "tsx --tsconfig tsconfig.web.json scripts/test-manual.tsx",
    "test:chordmap": "esbuild scripts/verify-chords.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/verify-chords/index.js --external:electron --external:better-sqlite3 --alias:@shared=./src/shared && electron out/verify-chords",
    "test:labsetup": "tsx --tsconfig tsconfig.node.json scripts/test-labsetup.ts"
  },
  "build": {
    "appId": "com.paulobrandao.guitarlab",
    "productName": "GuitarLab",
    "copyright": "Paulo Brandao",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "GuitarLab-${version}-instalador.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "GuitarLab",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "GuitarLab-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "synopsis": "Guitar practice: setlists, tabs, stems, chord charts and tones",
      "description": "Desktop app for consolidating a band setlist and practising guitar: Guitar Pro tablature, YouTube videos, chord sheets, chords detected from audio, tuning, GPU stem separation and per-section progress."
    },
    "publish": {
      "provider": "github",
      "owner": "paulobrandaodev",
      "repo": "GuitarLab",
      "releaseType": "draft"
    },
    "extraResources": [
      {
        "from": "lab",
        "to": "lab",
        "filter": [
          "app/**/*",
          "requirements/**/*",
          "!**/__pycache__/**"
        ]
      }
    ]
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@electron/rebuild": "^4.2.0",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pitchy": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
